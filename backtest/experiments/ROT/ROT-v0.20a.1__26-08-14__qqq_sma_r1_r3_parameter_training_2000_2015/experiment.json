  "research": {
    "stage": "exploratory_in_sample_training",
    "hypothesis": "R1+R3数值参数附近存在能够明显收窄2000-2015最大回撤、同时不过度牺牲收益的稳定局部平台。",
    "primary_metric": "最大回撤为第一指标；总收益门禁、Sharpe、持仓率、订单数和平台宽度为辅助指标。",
    "selection_rule": "先运行全部细步长OAT并保存；收益不得低于基线的70%，订单不得超过140且至少10笔闭合交易。在通过门禁的case中，先保留距最浅回撤1.0个百分点内的回撤平台，再保留距该平台最高总收益10个百分点内的case，取各参数中位附近代表。随后围绕OAT前三锚点做分组局部联合搜索，并用同一规则选择训练代表。",
    "validation_plan": "所有筛选case由独立状态机账本运行；基线及最终代表以PyBroker重新执行并逐日核对现金、持股、净值、订单日期/方向/价格及闭合交易。保存全部case、阶段映射、局部平台和数据哈希。",
    "promotion_criteria": "训练代表相对基线至少改善最大回撤3个百分点，总收益不低于基线70%，且不是任一已搜索数值边界上的孤立峰；之后必须冻结到未参与训练的2016年以后样本测试，方可进一步讨论。",
    "rejection_conditions": "若无case通过收益/活动门禁，若最优点位于边界且无平台，若回撤改善不足3个百分点，若使用2016年以后数据选参，或任一正式账本不一致，则拒绝训练代表。"
  }
